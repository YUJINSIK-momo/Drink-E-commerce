# PostgreSQL 연결 문자열 (Neon / Supabase / 로컬 Docker)
# 예) postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DATABASE_URL="postgresql://drink:drink@localhost:5432/drink?schema=public"

# 서버 포트 (Render 등은 PORT를 자동 주입함)
PORT=3000

# CORS 허용 오리진 (콤마로 구분). 프론트엔드(GitHub Pages) 주소를 넣는다.
# 예) https://yujinsik-momo.github.io,http://localhost:5173
CORS_ORIGINS="http://localhost:5173"
